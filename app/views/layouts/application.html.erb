<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Management System</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
      }

      header {
        background-color: #007bff;
        color: white;
        padding: 10px 20px;
        position: relative;
      }

      nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: flex-end;
      }

      nav ul li {
        margin: 0;
      }

      .logout-button {
        background-color: white;
        color: #007bff;
        border: 1px solid #007bff;
        border-radius: 5px;
        padding: 8px 15px;
        text-transform: uppercase;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.3s, color 0.3s;
      }

      .logout-button:hover {
        background-color: #007bff;
        color: white;
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <ul>
          <% if user_signed_in? %>
            <li>
              <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "logout-button", data: { confirm: "Are you sure you want to log out?" } %>
            </li>
          <% end %>
        </ul>
      </nav>
    </header>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
