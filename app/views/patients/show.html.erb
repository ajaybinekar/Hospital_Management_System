<h1 style="font-size: 28px; color: #007bff; margin-bottom: 20px;">Patient Profile: <%= @patient.first_name %></h1>

<div style="background-color: #ffffff; padding: 20px; border-radius: 10px; border: 1px solid #ccc; max-width: 600px; margin: auto; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
  <p style="font-size: 16px; margin: 10px 0;"><strong>First Name:</strong> <%= @patient.first_name %></p>
  <p style="font-size: 16px; margin: 10px 0;"><strong>Last Name:</strong> <%= @patient.last_name %></p>
  <p style="font-size: 16px; margin: 10px 0;"><strong>Date of Birth:</strong> <%= @patient.date_of_birth.strftime('%d/%m/%Y') if @patient.date_of_birth %></p>
  <p style="font-size: 16px; margin: 10px 0;"><strong>Contact Number:</strong> <%= @patient.contact_number %></p>
  <p style="font-size: 16px; margin: 10px 0;"><strong>Email:</strong> <%= @patient.email %></p>
  <p style="font-size: 16px; margin: 10px 0;"><strong>Gender:</strong> <%= @patient.gender %></p>
  <p style="font-size: 16px; margin: 10px 0;"><strong>Blood Group:</strong> <%= @patient.blood_group %></p>

  <h2 style="font-size: 24px; color: #007bff; margin-top: 20px;">Medical Records</h2>
  <% @patient.medical_records.each do |record| %>
    <div style="border: 1px solid #ddd; padding: 15px; border-radius: 5px; margin-bottom: 15px; background-color: #f8f9fa;">
      <p style="font-size: 16px; margin: 5px 0;"><strong>Condition:</strong> <%= record.condition %></p>
      <p style="font-size: 16px; margin: 5px 0;"><strong>Medication:</strong> <%= record.medication %></p>
      <% if record.document.attached? %>
        <p style="font-size: 16px; margin: 5px 0;"><strong>Document:</strong> <%= link_to 'Download', download_doctors_patient_medical_record_path(@patient, record), style: 'color: #007bff; text-decoration: underline;' %></p>
      <% else %>
        <p style="font-size: 16px; margin: 5px 0;"><strong>Document:</strong> No document attached.</p>
      <% end %>
    </div>
  <% end %>

  <div style="margin-top: 20px; text-align: right;">
    <%= link_to 'Download PDF', download_medical_record_patient_path(@patient), class: 'btn btn-primary', style: 'padding: 10px 15px; border-radius: 5px; background-color: #007bff; color: white; text-decoration: none; font-weight: bold; margin-right: 10px;' %>
    <%= link_to 'Back to Patients List', doctors_path, style: 'padding: 10px 15px; border-radius: 5px; background-color: #6c757d; color: white; text-decoration: none; font-weight: bold;' %>
  </div>
</div>