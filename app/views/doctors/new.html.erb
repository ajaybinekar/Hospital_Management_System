<h1>Add Medical Record for <%= @patient.full_name %></h1>

<%= form_with(model: @medical_record, local: true) do |form| %>
  <% if @medical_record.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@medical_record.errors.count, "error") %> prohibited this record from being saved:</h2>
      <ul>
        <% @medical_record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :condition %>
    <%= form.text_area :condition %>
  </div>

  <div class="field">
    <%= form.label :medication %>
    <%= form.text_area :medication %>
  </div>

  <div class="field">
    <%= form.label :document %>
    <%= form.file_field :document %>
  </div>

  <div class="actions">
    <%= form.submit 'Add Medical Record' %>
  </div>
<% end %>

<%= link_to 'Back to Patient Profile', doctor_path(@patient) %>