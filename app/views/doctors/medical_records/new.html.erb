<h1 style="font-size: 28px; color: #007bff; margin-bottom: 20px;">
  Add Medical Record for <%= @patient.first_name %>
</h1>

<%= form_with(model: [@patient, @medical_record], url: doctors_patient_medical_records_path(@patient), local: true) do |form| %>
  <% if @medical_record.errors.any? %>
    <div id="error_explanation" style="background-color: #ffefef; color: #d9534f; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #d9534f;">
      <h2 style="margin: 0 0 10px 0; font-size: 18px;">
        <%= pluralize(@medical_record.errors.count, "error") %> prohibited this record from being saved:
      </h2>
      <ul style="margin: 0; padding-left: 20px; list-style: none;">
        <% @medical_record.errors.full_messages.each do |message| %>
          <li style="margin-bottom: 5px;">• <%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="background-color: #ffffff; padding: 20px; border-radius: 10px; border: 1px solid #ccc; max-width: 600px; margin: auto; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);">
    <div class="field" style="margin-bottom: 20px;">
      <%= form.label :condition, style: 'font-weight: bold; color: #333;' %>
      <%= form.text_area :condition, style: 'width: 100%; padding: 10px; border: 1px solid #007bff; border-radius: 5px; font-size: 14px; color: #555; background-color: #f8f9fa;' %>
    </div>

    <div class="field" style="margin-bottom: 20px;">
      <%= form.label :medication, style: 'font-weight: bold; color: #333;' %>
      <%= form.text_area :medication, style: 'width: 100%; padding: 10px; border: 1px solid #007bff; border-radius: 5px; font-size: 14px; color: #555; background-color: #f8f9fa;' %>
    </div>

    <div class="field" style="margin-bottom: 20px;">
      <%= form.label :document, style: 'font-weight: bold; color: #333;' %>
      <%= form.file_field :document, style: 'border: 1px solid #007bff; border-radius: 5px; padding: 10px; font-size: 14px; color: #555; background-color: #f8f9fa;' %>
    </div>

    <div class="actions" style="margin-top: 20px; text-align: right;">
      <%= form.submit 'Add Medical Record', style: 'padding: 10px 15px; border-radius: 5px; background-color: #007bff; color: white; border: none; font-weight: bold; cursor: pointer; transition: background-color 0.3s ease;' %>
    </div>
  </div>
<% end %>

<div style="margin-top: 20px; text-align: center;">
  <%= link_to 'Back to Patient Profile', doctor_path(current_user.doctor), style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #6c757d; color: white;' %>
</div>