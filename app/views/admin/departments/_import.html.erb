<%= form_tag import_admin_departments_path, method: :post, multipart: true do %>
  <%= file_field_tag :file, accept: ".csv", style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #6c757d; color: white; margin-left: 10px;' %>
  <%= submit_tag '⚙️ Import', style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #17a2b8; color: white;' %>
<% end %>