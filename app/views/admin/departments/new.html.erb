<h1 style="font-size: 36px; color: #333; margin-bottom: 20px; text-align: center; font-weight: bold;">New Department</h1>

<div style="display: flex; justify-content: center; align-items: center; height: 56vh;">
  <div style="width: 400px; padding: 20px; border-radius: 10px; background-color: #fff; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
    <%= form_with(model: @department, url: admin_departments_path, local: true) do |form| %>
      
      <% if @department.errors.any? %>
        <div id="error_explanation" style="background-color: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
          <h2 style="font-size: 20px; font-weight: bold; margin-bottom: 10px;"><%= pluralize(@department.errors.count, "error") %> prohibited this department from being saved:</h2>
          <ul>
            <% @department.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Department Name Field -->
      <div class="field" style="margin-bottom: 20px;">
        <%= form.label :name, style: "font-size: 18px; font-weight: bold; color: #333;" %>
        <%= form.text_field :name, style: "width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 16px; color: #333;" %>
      </div>

      <!-- Submit Button -->
      <div class="actions" style="margin-top: 20px;">
        <%= form.submit 'Create Department', style: "background-color: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 5px; font-size: 18px; cursor: pointer; width: 100%;" %>
      </div>
    <% end %>

    <!-- Back Link -->
    <%= link_to 'Back', admin_departments_path, style: "display: inline-block; margin-top: 20px; color: #007bff; font-weight: bold; text-decoration: none; font-size: 16px;" %>
  </div>
</div>
