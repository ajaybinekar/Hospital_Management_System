<h1 style="font-size: 28px; color: #007bff; margin-bottom: 20px; text-align: center;">Beds</h1>

<div style="text-align: center; margin-bottom: 20px;">
  <%= link_to 'New Bed', new_admin_bed_path, style: 'text-decoration: none; font-weight: bold; padding: 10px 20px; border-radius: 5px; background-color: #28a745; color: white; font-size: 18px;' %>
  <%= link_to 'Back', admin_dashboard_path, style: 'text-decoration: none; font-weight: bold; padding: 10px 20px; border-radius: 5px; background-color: #6c757d; color: white; font-size: 18px; margin-left: 10px;' %>
</div>

<table style="width: 80%; margin: 0 auto; border-collapse: collapse; background-color: #f8f9fa; border: 1px solid #ddd; border-radius: 10px;">
  <thead>
    <tr style="background-color: #007bff; color: white; text-align: left; font-size: 18px;">
      <th style="padding: 15px; border-right: 1px solid #ddd;">Bed Number</th>
      <th style="padding: 15px; border-right: 1px solid #ddd;">Room</th>
      <th style="padding: 15px;">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @beds.each do |bed| %>
      <tr style="border-bottom: 1px solid #ddd; text-align: left;">
        <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= bed.number %></td>
        <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= bed.room.number if bed.room %></td>
        <td style="padding: 12px; font-size: 16px;">
          <%= link_to 'Show', admin_bed_path(bed), style: 'text-decoration: none; font-weight: bold; color: #007bff; margin-right: 10px;' %>
          <%= link_to 'Edit', edit_admin_bed_path(bed), style: 'text-decoration: none; font-weight: bold; color: #ffc107; margin-right: 10px;' %>
          <%= button_to 'Delete', admin_bed_path(bed), method: :delete, data: { confirm: 'Are you sure?' }, style: 'text-decoration: none; font-weight: bold; color: #dc3545; border: none; padding: 0;' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
