<h1 style="font-size: 28px; color: #007bff; margin-bottom: 15px; padding-bottom: 5px; border-bottom: 2px solid #ddd;">
  Room: <%= @room.number %>
</h1>

<p style="font-size: 16px; margin: 10px 0;">
  <strong style="color: #495057;">Department:</strong> <%= @room.department.name if @room.department.present? %>
</p>
<p style="font-size: 16px; margin: 10px 0;">
  <strong style="color: #495057;">Capacity:</strong> <%= @room.capacity %>
</p>
<p style="font-size: 16px; margin: 10px 0;">
  <strong style="color: #495057;">Current Admissions:</strong> <%= @room.admissions.count %>
</p>

<% if @room.admissions.any? %>
  <h3 style="font-size: 22px; color: #28a745; margin-top: 20px;">Current Patients:</h3>
  <ul style="list-style: none; padding: 0; margin-top: 10px;">
    <% @room.admissions.each do |admission| %>
      <li style="background-color: #f8f9fa; border: 1px solid #ddd; padding: 10px 15px; margin-bottom: 10px; border-radius: 5px; display: flex; justify-content: space-between; align-items: center;">
        <%= admission.patient.first_name %> <%= admission.patient.last_name %>
        (Admitted on: <%= admission.admission_date.strftime("%B %d, %Y") %>)
      </li>
    <% end %>
  </ul>
<% else %>
  <p style="font-size: 16px; color: #dc3545; font-weight: bold;">No current admissions.</p>
<% end %>

<div style="margin-top: 20px;">
  <%= link_to 'Edit', edit_admin_room_path(@room), style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #17a2b8; color: #fff; margin-right: 5px;' %>
  <%= link_to 'Back', admin_rooms_path, style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #6c757d; color: #fff;' %>
</div>
