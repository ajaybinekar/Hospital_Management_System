<%= form_with(model: @room, url: admin_rooms_path, local: true, style: 'display: flex; justify-content: center; align-items: center; min-height: 100vh; background-color: #f8f9fa; padding: 20px;') do |form| %>
  <div style="background-color: #ffffff; padding: 20px; border-radius: 10px; border: 1px solid #ccc; max-width: 600px; width: 100%; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); margin: auto;">
    <% if @room.errors.any? %>
      <div id="error_explanation" style="background-color: #ffefef; color: #d9534f; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #d9534f;">
        <h2 style="margin: 0 0 10px 0; font-size: 18px;"><%= pluralize(@room.errors.count, "error") %> prohibited this room from being saved:</h2>
        <ul style="margin: 0; padding-left: 20px; list-style: none;">
          <% @room.errors.full_messages.each do |message| %>
            <li style="margin-bottom: 5px;">• <%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field" style="margin-bottom: 20px;">
      <%= form.label :number, style: 'font-weight: bold; color: #333;' %><br>
      <%= form.text_field :number, style: 'width: 94%; padding: 10px; border: 1px solid #007bff; border-radius: 5px; font-size: 14px;' %>
    </div>

    <div class="field" style="margin-bottom: 20px; width: 100%; max-width: 500px; margin: 0 auto;">
      <%= form.label :department_id, 'Department', style: 'font-weight: bold; color: #333; display: block; margin-bottom: 8px;' %>
      <%= form.collection_select :department_id, Department.all, :id, :name, prompt: 'Select a Department', 
        style: 'width: 100%; padding: 12px 16px; border: 1px solid #007bff; border-radius: 5px; font-size: 14px; color: #555; 
               background-color: #fff; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); transition: all 0.3s ease; 
               appearance: none; cursor: pointer; text-align: left;' %>
    </div>

    <div class="actions" style="margin-top: 30px; text-align: right;">
      <%= form.submit 'Save Room', style: 'text-decoration: none; font-weight: bold; padding: 12px 20px; border-radius: 5px; background-color: #007bff; color: #fff; border: none; font-size: 14px; cursor: pointer; transition: background-color 0.3s ease;' %>
    </div>
  </div>
<% end %>