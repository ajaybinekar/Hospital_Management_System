<h1 style="font-size: 28px; color: #007bff; margin-bottom: 20px;">Rooms</h1>

<div style="margin-bottom: 20px; text-align: center;">
  <%= link_to 'New Room', new_admin_room_path, style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #28a745; color: white; margin-right: 10px;' %>
  <%= link_to 'Room Utilization Report (CSV)', utilization_report_admin_rooms_path(format: :csv), style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #17a2b8; color: white;' %>
  <%= link_to 'Back', admin_dashboard_path, style: 'text-decoration: none; font-weight: bold; padding: 8px 12px; border-radius: 5px; background-color: #6c757d; color: white; margin-left: 10px;' %>
</div>

<table style="width: 100%; border-collapse: collapse; background-color: #f8f9fa; border: 1px solid #ddd;">
  <thead>
    <tr style="background-color: #007bff; color: white; text-align: left;">
      <th style="padding: 10px; border: 1px solid #ddd;">Room Number</th>
      <th style="padding: 10px; border: 1px solid #ddd;">Department</th>
      <th style="padding: 10px; border: 1px solid #ddd;">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr style="border-bottom: 1px solid #ddd;">
        <td style="padding: 10px; border: 1px solid #ddd;"><%= room.number %></td>
        <td style="padding: 10px; border: 1px solid #ddd;"><%= room.department.name if room.department %></td>
        <td style="padding: 10px; border: 1px solid #ddd; display: flex; gap: 10px;">
          <%= link_to 'Show', admin_room_path(room), style: 'text-decoration: none; font-weight: bold; padding: 6px 10px; border-radius: 5px; background-color: #007bff; color: white;' %>
          <%= link_to 'Edit', edit_admin_room_path(room), style: 'text-decoration: none; font-weight: bold; padding: 6px 10px; border-radius: 5px; background-color: #ffc107; color: white;' %>
          <%= button_to 'Delete', admin_room_path(room), method: :delete, data: { confirm: 'Are you sure?' }, style: 'font-weight: bold; padding: 6px 10px; border-radius: 5px; background-color: #dc3545; color: white; border: none;' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
