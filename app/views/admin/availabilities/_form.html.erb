<div style="display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f4f6f9;">
  <div style=" border-radius: 10px;padding: 30px; width: 500px;">
    
    <h1 style="font-size: 28px; color: #007bff; margin-bottom: 20px; text-align: center;">New Availability</h1>

    <%= form_with(model: @availability, url: admin_availabilities_path, local: true) do |form| %>
      
      <% if @availability.errors.any? %>
        <div id="error_explanation" style="background-color: #f8d7da; color: #721c24; padding: 15px; margin-bottom: 20px; border-radius: 5px;">
          <h2><%= pluralize(@availability.errors.count, "error") %> prohibited this availability from being saved:</h2>
          <ul style="list-style: none; padding-left: 0;">
            <% @availability.errors.full_messages.each do |message| %>
              <li style="font-size: 16px;"><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Doctor ID Field -->
      <div class="field" style="margin-bottom: 15px;">
        <%= form.label :doctor_id, style: 'font-size: 16px; font-weight: bold;' %>
        <%= form.collection_select :doctor_id, @doctors, :id, :first_name, { prompt: 'Select a Doctor' }, style: 'padding: 10px; font-size: 16px; width: 100%; border: 1px solid #ccc; border-radius: 5px;' %>
      </div>

      <!-- Start Time Field -->
      <div class="field" style="margin-bottom: 15px;">
        <%= form.label :start_time, style: 'font-size: 16px; font-weight: bold;' %>
        <%= form.datetime_select :start_time, style: 'padding: 10px; font-size: 16px; width: 100%; border: 1px solid #ccc; border-radius: 5px;' %>
      </div>

      <!-- End Time Field -->
      <div class="field" style="margin-bottom: 15px;">
        <%= form.label :end_time, style: 'font-size: 16px; font-weight: bold;' %>
        <%= form.datetime_select :end_time, style: 'padding: 10px; font-size: 16px; width: 100%; border: 1px solid #ccc; border-radius: 5px;' %>
      </div>

      <!-- Status Field -->
      <div class="field" style="margin-bottom: 15px;">
        <%= form.label :status, style: 'font-size: 16px; font-weight: bold;' %>
        <%= form.select :status, options_for_select([['Available', 'available'], ['Unavailable', 'unavailable'], ['Booked', 'booked']], @availability.status), style: 'padding: 10px; font-size: 16px; width: 100%; border: 1px solid #ccc; border-radius: 5px;' %>
      </div>

      <!-- Duration Field -->
      <div class="field" style="margin-bottom: 20px;">
        <%= form.label :duration, style: 'font-size: 16px; font-weight: bold;' %>
        <%= form.number_field :duration, style: 'padding: 10px; font-size: 16px; width: 100%; border: 1px solid #ccc; border-radius: 5px;' %>
      </div>

      <!-- Submit Button -->
      <div class="actions" style="text-align: center;">
        <%= form.submit 'Create Availability', class: 'btn btn-primary', style: 'padding: 10px 20px; font-size: 18px; background-color: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer;' %>
      </div>
    <% end %>

    <!-- Back Button -->
    <div style="text-align: center; margin-top: 20px;">
      <%= link_to 'Back', admin_availabilities_path, class: 'btn btn-secondary', style: 'padding: 10px 20px; font-size: 18px; background-color: #6c757d; color: white; border-radius: 5px; text-decoration: none;' %>
    </div>

  </div>
</div>
