<div style="text-align: center; margin-top: 30px;">
  <h1 style="font-size: 28px; color: #007bff; margin-bottom: 20px;">Doctor Availability</h1>
  
  <!-- Back Button -->
  <div style="margin-bottom: 20px;">
    <%= link_to 'Back', admin_dashboard_path, style: 'text-decoration: none; font-weight: bold; padding: 10px 20px; border-radius: 5px; background-color: #6c757d; color: white; font-size: 18px;' %>
  </div>
  
  <!-- Availability Table -->
  <table style="width: 80%; margin: 0 auto; border-collapse: collapse; background-color: #f8f9fa; border: 1px solid #ddd; border-radius: 10px;">
    <thead>
      <tr style="background-color: #007bff; color: white; text-align: left; font-size: 18px;">
        <th style="padding: 15px; border-right: 1px solid #ddd;">Doctor</th>
        <th style="padding: 15px; border-right: 1px solid #ddd;">Start Time</th>
        <th style="padding: 15px; border-right: 1px solid #ddd;">End Time</th>
        <th style="padding: 15px; border-right: 1px solid #ddd;">Status</th>
        <th style="padding: 15px; border-right: 1px solid #ddd;">Duration (minutes)</th>
        <th style="padding: 15px;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @availabilities.each do |availability| %>
        <tr style="border-bottom: 1px solid #ddd; text-align: left;">
          <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= availability.doctor.first_name %></td>
          <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= availability.start_time %></td>
          <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= availability.end_time %></td>
          <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= availability.status %></td>
          <td style="padding: 12px; font-size: 16px; border-right: 1px solid #ddd;"><%= availability.duration %></td>
          <td style="padding: 12px; font-size: 16px;">
            <%= link_to 'Edit', edit_admin_availability_path(availability), style: 'text-decoration: none; font-weight: bold; color: #ffc107; margin-right: 10px;' %>
            <%= button_to 'Delete', admin_availability_path(availability), method: :delete, data: { confirm: 'Are you sure?' }, style: 'font-weight: bold; color: #dc3545; background-color: transparent; border: none; cursor: pointer;' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  
  <!-- New Availability Link -->
  <div style="margin-top: 20px;">
    <%= link_to 'New Availability', new_admin_availability_path, style: 'text-decoration: none; font-weight: bold; padding: 10px 20px; border-radius: 5px; background-color: #28a745; color: white; font-size: 18px;' %>
  </div>
</div>
