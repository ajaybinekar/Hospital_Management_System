<h1>Edit Doctor</h1>

<%= form_with(model: @doctor, url: admin_doctor_path(@doctor), local: true) do |form| %>
  <% if @doctor.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@doctor.errors.count, "error") %> prohibited this doctor from being saved:</h2>
      <ul>
        <% @doctor.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :first_name %>
    <%= form.text_field :first_name, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :middle_name %>
    <%= form.text_field :middle_name, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :last_name %>
    <%= form.text_field :last_name, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :date_of_birth %>
    <%= form.date_field :date_of_birth, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :contact_number %>
    <%= form.telephone_field :contact_number, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :nationality %>
    <%= form.text_field :nationality, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :gender %>
    <%= form.select :gender, ['Male', 'Female', 'Other'], {}, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :qualifications %>
    <%= form.text_area :qualifications, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :experience %>
    <%= form.text_area :experience, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :department_id %>
    <%= form.collection_select :department_id, Department.all, :id, :name, { prompt: 'Select a Department' }, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :photo %>
    <%= form.file_field :photo, class: 'form-control' %>
  </div>

  <div class="actions">
    <%= form.submit 'Update Doctor', class: 'btn btn-primary' %>
  </div>
<% end %>

<%= link_to 'Back', admin_doctors_path, class: 'btn btn-secondary' %>
